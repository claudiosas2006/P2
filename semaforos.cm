#include "gdefs.cm"

const int tamano_buffer = 5;
semaphore e, s, n;
int buffer[tamano_buffer];
int in=0, out=0;

int producir(int id) {
    int producto;
    producto = random(100)+1;
    cout << "El productor " << id << " produce el producto " << producto << endl; 
    return producto;
}

void anadir_buffer(int producto) {
    buffer[in] = producto;

    if (in == 0) {
	changecolor(1, 1);
    }
    else if (in == 1) {
	changecolor(2, 1);
    }
    else if (in == 2) {
	changecolor(3, 1);
    }
    else if (in == 3) {
	changecolor(4, 1);
    }
    else if (in == 4) {
	changecolor(5, 1);
    }

    in = (in+1) % tamano_buffer;
}

void productor(int id){
    int pro, i;
    for(i = 0; i < tamano_buffer; i++) {
        pro = producir(id);
        p(e);
        p(s);
        anadir_buffer(pro);
        v(s);
        v(n);
    }
}

void consumir(int id, int producto) {
    cout << "El consumidor " << id << " consume el producto " << producto << endl; 
}

int coger_buffer(int id) {
    int producto;
    producto = buffer[out];

    if (out == 0) {
	changecolor(1, 3);
    }
    else if (out == 1) {
	changecolor(2, 3);
    }
    else if (out == 2) {
	changecolor(3, 3);
    }
    else if (out == 3) {
	changecolor(4, 3);
    }
    else if (out == 4) {
	changecolor(5, 3);
    }

    out = (out+1) % tamano_buffer;
    return producto;
}

void consumidor(int id){
    int pro, i;
    for(i = 0; i < tamano_buffer; i++) {
        p(n);
        p(s);
        pro = coger_buffer(id);
        v(s);
        v(e);
        consumir(id, pro);
    }
}

void main() {
    initialsem(s, 1);
    initialsem(n, 0);
    initialsem(e, tamano_buffer);

    create(1, 1, 3, 50, 200, 50, 50);
    create(2, 1, 3, 130, 200, 50, 50);
    create(3, 1, 3, 210, 200, 50, 50);
    create(4, 1, 3, 290, 200, 50, 50);
    create(5, 1, 3, 370, 200, 50, 50);

    cobegin {
        productor(1);
        productor(2);
        consumidor(1);
	    consumidor(2);
    }
}